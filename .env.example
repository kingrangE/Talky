# === LLM ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=skt/A.X-4.0-Light
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_INPUT_BYTES=24000
MAX_USER_TEXT_CHARS=4000
MAX_HISTORY_BYTES=12000
MAX_AUDIO_BYTES=5000000
MAX_AUDIO_SECONDS=90

# === Langfuse Cloud ===
# 프로젝트 Settings > API Keys의 URL과 키. 키는 채팅·Git에 올리지 마세요.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
# 재현 평가에서는 프롬프트별 숫자 버전 지정 (JSON). 새 대화부터 적용됩니다.
LANGFUSE_PROMPT_VERSIONS={}
# 실행한 Git commit SHA 등을 지정하면 trace의 코드 버전을 구분할 수 있습니다.
LANGFUSE_RELEASE=

# === STT/TTS (Phase C 부터) ===
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE_EN=en_US-amy-medium
TTS_VOICE_KO=ko_KR-kss-medium
AUDIO_CACHE_DIR=./.cache

# === Speaking Mock Test ===
# Public demo defaults: one attempt per visitor/day and one active exam globally.
MOCK_EXAM_DATA_DIR=./.data/mock-exam
MOCK_EXAM_AUDIO_TTL_HOURS=72
MOCK_EXAM_RESULT_TTL_HOURS=72
MOCK_EXAM_RECOVERY_TTL_MINUTES=10
MOCK_EXAM_DAILY_LIMIT=1
MOCK_EXAM_GLOBAL_CONCURRENCY=1
MOCK_EXAM_SCORING_TIMEOUT_SECONDS=90
MOCK_EXAM_JOB_TIMEOUT_SECONDS=180
MOCK_EXAM_MAX_ATTEMPTS=3
MOCK_EXAM_CLEANUP_INTERVAL_SECONDS=60
MOCK_EXAM_SCORING_PROFILE=auto
# Production deployments must replace these two values with long random secrets.
MOCK_EXAM_SIGNING_SECRET=
MOCK_EXAM_FINGERPRINT_SALT=replace-in-production
MOCK_EXAM_REVIEW_MODEL=qwen2.5:7b

# === Postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talky
POSTGRES_USER=talky
POSTGRES_PASSWORD=talky

# === Neo4j (Phase E 부터) ===
# Neo4j 5 는 password 로 'neo4j' 를 거부하므로 다른 값 필수
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=talky-dev-pw

# === App ===
# Legacy seed CLI only; the conversation UI uses authenticated account IDs.
APP_USER_ID=
EVOLVE_BATCH=5
ROLLBACK_THRESHOLD=0.5
EMBED_MODEL=BAAI/bge-m3
