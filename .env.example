# === LLM ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=skt/A.X-4.0-Light
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === STT/TTS (Phase C 부터) ===
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE_EN=en_US-amy-medium
TTS_VOICE_KO=ko_KR-kss-medium
AUDIO_CACHE_DIR=./.cache

# === Postgres ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talky
POSTGRES_USER=talky
POSTGRES_PASSWORD=talky

# === Neo4j (Phase E 부터) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# === App ===
APP_USER_ID=
EVOLVE_BATCH=5
ROLLBACK_THRESHOLD=0.5
EMBED_MODEL=BAAI/bge-m3
